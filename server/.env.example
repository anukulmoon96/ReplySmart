# Copy to server/.env and fill in what you need. Everything is optional.
# Add a key for any provider you want to use; each one appears under "Write with" in the app.
# With no keys at all, you can still use the free web-chat mode (ChatGPT, Gemini or
# Claude.ai websites), and the built-in replies fall back to templates.

# Default provider: auto (the first configured one, in the order below), claude, openai,
# gemini, compatible or demo. Use AI_PROVIDER=claude if you signed in with `ant auth login`.
AI_PROVIDER=auto

# --- Claude (Anthropic) - https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Low keeps replies fast.
CLAUDE_EFFORT=low

# --- ChatGPT models (OpenAI API) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional, for reasoning models (e.g. low for faster replies). Leave empty for other models.
OPENAI_REASONING_EFFORT=

# --- Gemini (Google) - free-tier keys at https://aistudio.google.com/apikey
# Note: on the free tier, Google may use your prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Any OpenAI-compatible server: Ollama (free, runs locally), LM Studio, Groq, OpenRouter...
# Ollama example: BASE_URL=http://localhost:11434/v1, MODEL=llama3.2, API key not needed.
OPENAI_COMPATIBLE_NAME=Local model
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# How many of the latest messages to send to the AI per request.
MAX_PROMPT_MESSAGES=400

# MongoDB connection string. Leave empty to use the embedded database in server/.data/db.
MONGODB_URI=

# API port. The Vite dev server proxies /api here. `npm start` also accepts PORT.
API_PORT=5050
HOST=127.0.0.1
